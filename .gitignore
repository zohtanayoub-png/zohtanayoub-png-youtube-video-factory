# ---- secrets (never commit these) ------------------------------------------
.env
.env.*
!.env.example
client_secret*.json
client_secrets*.json
*credentials*.json
token.json
*.pem

# ---- generated media (never commit video) ----------------------------------
output/
work/
*.mp4
*.mkv
*.mov
*.webm
*.wav
*.mp3
*.m4a
!tests/fixtures/**

# ---- caches ----------------------------------------------------------------
.cache/
assets/local_clips/*
!assets/local_clips/.gitkeep
!assets/local_clips/README.md

# ---- database working files (the durable copy lives in data/state/*.json) ---
data/*.db
data/*.db-wal
data/*.db-shm

# ---- python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ---- editors / os ----------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
