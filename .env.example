# ===========================================================================
#  EXAMPLE ENVIRONMENT FILE
#
#  This file is a TEMPLATE. It contains no real keys and is safe to commit.
#
#  For cloud generation you do NOT need this file at all - put the same
#  values into GitHub Secrets instead:
#     Settings -> Secrets and variables -> Actions -> New repository secret
#
#  Only copy this to ".env" if you want to run the pipeline on your own
#  computer. ".env" is git-ignored and must never be committed.
# ===========================================================================

# --- Stock footage (required: at least PEXELS_API_KEY) ---------------------
# Free key from https://www.pexels.com/api/
PEXELS_API_KEY=

# Optional, also free: https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# --- YouTube upload (optional - leave empty to keep uploads off) -----------
# See SETUP.md, section "Optional: automatic YouTube uploads".
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- Advanced (optional) ---------------------------------------------------
# Where downloaded voices and models are cached.
# VIDFACTORY_CACHE=.cache
# Use a Piper voice file you downloaded yourself.
# VIDFACTORY_PIPER_MODEL=
# Use a GGUF model you downloaded yourself (only for the optional LLM mode).
# VIDFACTORY_GGUF=
# Folder of your own footage for sources.local.
# VIDFACTORY_LOCAL_CLIPS=assets/local_clips
